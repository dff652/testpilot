{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestPilot knowledge 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "knowledge_id",
    "project_id",
    "visibility",
    "kind",
    "status",
    "title",
    "content",
    "source",
    "reviewer",
    "verified_at",
    "evidence",
    "shared_by",
    "superseded_by",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "knowledge_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "visibility": {
      "enum": [
        "project",
        "shared"
      ]
    },
    "kind": {
      "enum": [
        "incident",
        "strategy",
        "lesson"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "verified",
        "stale",
        "superseded"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "path",
        "commit",
        "sha256",
        "line_start",
        "line_end"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001f]).+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "verified_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "run_id"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          },
          "run_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
          }
        }
      },
      "minItems": 0,
      "maxItems": 256
    },
    "shared_by": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "superseded_by": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_id",
            "knowledge_id"
          ],
          "properties": {
            "project_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
            },
            "knowledge_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "reviewed",
              "verified"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reviewer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "verified_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "visibility": {
            "const": "shared"
          }
        }
      },
      "then": {
        "properties": {
          "shared_by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "status": {
            "enum": [
              "reviewed",
              "verified",
              "stale",
              "superseded"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        }
      },
      "then": {
        "properties": {
          "superseded_by": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "project_id",
              "knowledge_id"
            ],
            "properties": {
              "project_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
              },
              "knowledge_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
              }
            }
          }
        }
      }
    }
  ]
}
