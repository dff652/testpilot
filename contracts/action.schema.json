{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestPilot action 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "action_id",
    "adapter_id",
    "kind",
    "runner",
    "policy",
    "acceptance",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "kind": {
      "enum": [
        "test",
        "check"
      ]
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable",
        "argv",
        "cwd"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "argv": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "value"
                ],
                "properties": {
                  "type": {
                    "const": "literal"
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 2048
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "value"
                ],
                "properties": {
                  "type": {
                    "const": "path"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^(?!/)(?!.*:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001f]).+$"
                  }
                }
              }
            ]
          },
          "minItems": 0,
          "maxItems": 256
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001f]).+$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "network",
        "secrets",
        "platforms",
        "timeout_seconds",
        "locks",
        "prerequisites"
      ],
      "properties": {
        "effect": {
          "enum": [
            "inspect",
            "workspace-write"
          ]
        },
        "network": {
          "enum": [
            "none",
            "loopback",
            "external"
          ]
        },
        "secrets": {
          "const": "forbidden"
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": [
              "linux"
            ]
          },
          "minItems": 1,
          "maxItems": 256
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "locks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 1,
          "maxItems": 256
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 0,
          "maxItems": 256
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parser",
        "required_artifacts",
        "require_test_counts"
      ],
      "properties": {
        "parser": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
        },
        "required_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001f]).+$"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "require_test_counts": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "commit",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\u0000-\\u001f]).+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "test"
          }
        }
      },
      "then": {
        "properties": {
          "acceptance": {
            "properties": {
              "require_test_counts": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
