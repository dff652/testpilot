      "POSIX shell/make and complete fixture tree",
      "Adapter must require final SUMMARY and positive assertion count"
    ]
  },
  "acceptance": {
    "parser": "doctor-summary",
    "required_artifacts": [
      "native-output.log"
    ],
    "require_test_counts": true
  },
