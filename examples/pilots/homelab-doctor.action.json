{
  "schema_version": "0.1.0",
  "project_id": "homelab-doctor",
  "action_id": "make.test",
  "adapter_id": "doctor-summary",
  "kind": "test",
  "runner": {
    "executable": "make",
    "argv": [
      {
        "type": "literal",
        "value": "test"
      }
    ],
    "cwd": "."
